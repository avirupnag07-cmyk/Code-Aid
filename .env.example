# Copy to .env for local overrides. No secret is required for the core build.
CODE_AID_ALLOWED_ORIGINS=http://localhost:5173
CODE_AID_MAX_UPLOAD_BYTES=10485760
CODE_AID_RUN_TIMEOUT_SECONDS=20
CODE_AID_DOCKER_IMAGE=code-aid-runner:0.1.0
CODE_AID_GIT_TIMEOUT_SECONDS=60
# Optional GitHub OAuth App settings. Leave blank to keep private imports disabled.
CODE_AID_GITHUB_CLIENT_ID=
CODE_AID_GITHUB_CLIENT_SECRET=
CODE_AID_GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
CODE_AID_OAUTH_COOKIE_SECRET=
