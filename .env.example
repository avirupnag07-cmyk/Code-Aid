# Copy to .env for local overrides. No secret is required for the core build.
# Include the Vercel origin when the deployed frontend calls this local API.
CODE_AID_ALLOWED_ORIGINS=http://localhost:5173,https://your-project.vercel.app
CODE_AID_MAX_UPLOAD_BYTES=10485760
CODE_AID_RUN_TIMEOUT_SECONDS=20
CODE_AID_DOCKER_IMAGE=code-aid-runner:0.1.0
