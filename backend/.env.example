# Optional runtime overrides. Values are relative to the repository root unless absolute.
CODE_AID_DATABASE=backend/data/code_aid.sqlite3
CODE_AID_STORAGE=backend/data/investigations
CODE_AID_SAMPLES=samples
CODE_AID_MAX_UPLOAD_BYTES=10485760
CODE_AID_MAX_ARCHIVE_MEMBERS=200
CODE_AID_MAX_ARCHIVE_BYTES=26214400
CODE_AID_MAX_ARCHIVE_MEMBER_BYTES=5242880
CODE_AID_RUN_TIMEOUT_SECONDS=20
CODE_AID_DOCKER_IMAGE=code-aid-runner:0.1.0
CODE_AID_ALLOWED_ORIGINS=*
